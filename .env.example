
NODE_ENV=development
PORT=3000

# --- Plane -------------------------------------------------------------------
# Plane Cloud:  PLANE_API_URL=https://api.plane.so/api/v1
#               PLANE_APP_URL=https://app.plane.so
# Self-hosted:  PLANE_API_URL=https://plane.example.com/api/v1
#               PLANE_APP_URL=https://plane.example.com
# Include the /api/v1 prefix on the API URL. APP_URL builds the spreadsheet's
# link column, and differs from the API host on Cloud.
PLANE_API_URL=
PLANE_APP_URL=

# Workspace scoped personal access token: Plane → Workspace Settings → API tokens.
# Sent as the X-API-Key header. Exports only see what this token's owner can see.
PLANE_API_KEY=

# Workspace slug: the first path segment after the host in any Plane URL.
# https://app.plane.so/acme/projects/... -> acme
PLANE_WORKSPACE_SLUG=

# --- Throttling and paging ---------------------------------------------------
# Plane throttles per API key. On self-hosted the server side value is the API
# container's API_KEY_RATE_LIMIT (default 60/minute); keep this one below it.
PLANE_RATE_LIMIT_PER_MINUTE=55

# Plane caps per_page at 100 and silently ignores larger values.
PLANE_PAGE_SIZE=100

# Safety cap on total pages per list call.
PLANE_MAX_PAGES=500

PLANE_REQUEST_TIMEOUT_MS=30000
PLANE_MAX_RETRIES=4
PLANE_RETRY_BASE_MS=500

    
# --- Lookup cache ------------------------------------------------------------
# Short by design: lookups change rarely, but a rename that does not show up in a
# report is noticed immediately. Callers can force a refresh per export.
LOOKUP_CACHE_TTL_SECONDS=300

# Optional. Without it the lookup cache is per process, which is fine for the CLI
# but means a forced refresh only affects the instance that handled the request.
# REDIS_URL=redis://localhost:6379

# --- Not used yet ------------------------------------------------------------
# Reserved for saved filter presets, which are not implemented.
# DATABASE_URL=
